{
  // The library, its tests and the dev page, type-checked together (npm run check)
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowArbitraryExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "dev/**/*.ts", "vitest.config.ts", "vitest.bench.config.ts"],
  // Generated by wasm-bindgen; its .d.ts is used for types
  "exclude": ["tessellator/pkg/*.js", "dist"]
}
